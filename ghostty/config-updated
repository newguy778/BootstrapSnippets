# Ghostty config - ~/.config/ghostty/config  (option names checked against 1.3.1)
# Reload after edits: cmd+shift+,   (there is no `ghostty +reload-config`)
# On macOS, background-opacity and quick-terminal-position only change after a
# full quit and relaunch. Typo check: ghostty +validate-config

# --- Appearance: merge tabs into the titlebar (Safari-style) ---------------
macos-titlebar-style = tabs

# --- Theme -----------------------------------------------------------------
theme = Catppuccin Mocha
window-colorspace = display-p3

# --- Liquid Glass (macOS 26+) ----------------------------------------------
# In 1.3.1 the glass is tinted with the theme background at background-opacity,
# so opacity is the glass dial: 1.0 is a flat solid color, lower is clearer glass.
#   0.5-0.6  obvious glass, needs a calm wallpaper behind it
#   0.7      balanced default
#   0.85+    mostly solid, a hint of glass
# Inactive windows get a darker overlay automatically. `macos-glass-clear` is
# even more see-through and usually hurts text legibility.
background-blur = macos-glass-regular
background-opacity = 0.7
# Let cells with their own background (nvim, tmux bars) turn translucent too:
# background-opacity-cells = true
# Before macOS 26, use plain blur instead of the two glass lines above:
# background-blur = true
# background-opacity = 0.96

# Glass-matched Dock icon (only affects the Dock and app switcher)
macos-icon = glass

# --- Padding ---------------------------------------------------------------
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = background

# --- Window state ----------------------------------------------------------
window-save-state = always
window-new-tab-position = current
tab-inherit-working-directory = true

# --- Splits ----------------------------------------------------------------
split-divider-color = #585b70
unfocused-split-opacity = 0.8

# --- Font ------------------------------------------------------------------
# macOS draws thin strokes on low-DPI screens such as 27" 2K monitors. Thickening
# fixes that, but can look heavy on the MacBook's Retina display. If so, lower
# the strength (0-255, default 255) or turn thickening off.
font-thicken = true
# font-thicken-strength = 160
# font-family = JetBrains Mono
# font-size = 13
# adjust-cell-height = 10%

# --- Optional extras (off until you uncomment) -----------------------------
# Option key acts as Alt (word jumps in zsh, tmux, vim). Disables typing
# Option-characters such as é or ©.
# macos-option-as-alt = true
# mouse-hide-while-typing = true

# Notification when a long command finishes in a window you are not looking at.
# Needs shell integration (Ghostty injects it for zsh) and notification permission.
# notify-on-command-finish = unfocused
# notify-on-command-finish-after = 30s
# notify-on-command-finish-action = notify

# Drop-down terminal on a global hotkey. Pick a combo no other app uses, and
# grant Ghostty Accessibility access when macOS asks.
# quick-terminal-position = top
# quick-terminal-size = 45%
# keybind = global:ctrl+alt+space=toggle_quick_terminal
